// Question 1: Shopping Discount

// Task: Calculate the final price of an item based on a purchaseAmount:

// $100 or more: 20% discount
// $50 to $99.99: 10% discount
// Under $50: No discount

let purchaseAmount = 120;
let finalPrice;

if (purchaseAmount >= 100) {
  finalPrice = purchaseAmount - purchaseAmount * 0.20;
} else if (purchaseAmount >= 50) {
  finalPrice = purchaseAmount - purchaseAmount * 0.10;
} else {
  finalPrice = purchaseAmount;
}

console.log("Final price: $" + finalPrice);